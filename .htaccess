Options -MultiViews
DirectoryIndex index.html
RewriteEngine On

# Servir archivos y directorios reales sin modificación
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# No redirigir rutas API al fallback de la SPA.
# Si el host no tiene proxy/backend para /api, debe fallar de forma explicita.
RewriteRule ^api(?:/|$) - [L]

# SPA fallback
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
