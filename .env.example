# Copia este archivo como .env y configura tus credenciales reales.
# IMPORTANTE: Nunca subas el archivo .env con secretos a git.
# Este archivo solo lista los valores privados. Los valores no secretos
# tienen defaults en el código y se pueden sobrescribir opcionalmente.

# Discord OAuth
CLIENT_SECRET=tu_client_secret_de_discord
SESSION_SECRET=un-string-seguro-cualquiera

# Frontend (Vite): API key de imgBB, se expone al bundle
VITE_API_KEY_IMGBB=tu_imgbb_api_key

# Kaith AI
KAITH_AI_USER=tu_usuario_api_ia
KAITH_AI_PASSWORD=tu_password_api_ia

# H.E.X. AI gateway (https://api.kaithsrebels.com/v1/text)
KAITH_AI_GATEWAY_TOKEN=tu_token_gateway_ia

# WordPress (ingesta de reportes)
WORDPRESS_API_SECRET=tu_secret_wordpress

# Overrides opcionales (descomentar solo si el valor debe cambiar):
# PORT=5000
# DEBUG_MODE=false
# CLIENT_ID=tu_client_id_de_discord
# CALLBACK_URL=http://localhost:5000/auth/discord/callback
# AUTH_REQUIRE_LOGIN=true
# AUTH_ALLOWED_DISCORD_USER_IDS=123456789012345678,987654321098765432
# AUTH_FRONTEND_SUCCESS_URL=http://localhost:5180/auth-callback
# Despacho: IDs del servidor Discord y roles de staff separados por coma.
# Sin ambos valores la gestion queda deshabilitada (fail closed).
# DISCORD_STAFF_GUILD_ID=123456789012345678
# DISCORD_STAFF_ROLE_IDS=234567890123456789,345678901234567890
# OAuth siempre solicita guilds.members.read; sesiones antiguas deben autorizar de nuevo.
# Tokens de acceso/refresh quedan solo en sesion del servidor. Error Discord nunca concede acceso.
# Despacho lee todas las paginas de /wp-json/mostwanted/v1/reports de WORDPRESS_API_BASE_URL.
# No utiliza data/reportes.json ni votos locales como fuente nueva.
# Notas y auditoria: data/expedientes.json, reemplazo atomico + lock entre procesos.
# El endpoint heredado de reportes se mantiene; su campo opcional notes ahora exige rol staff
# y crea una nota con autoria. Texto historico sin autoria permanece separado en legacyNotes.
# Ante lock huerfano tras crash, revisar procesos y recuperar data/expedientes.lock manualmente.
# Si WordPress falla se devuelve ultimo snapshot persistido con source.stale=true;
# sin snapshot se responde 502 y reports:null (nunca un falso cero).
# WORDPRESS_REPORTS_ENABLED=true
# WORDPRESS_API_BASE_URL=https://kaithsrebels.com
# KAITH_AI_USE_LOCAL_OLLAMA=true
# VITE_DISCORD_ID_CHANNEL=tu_channel_id
