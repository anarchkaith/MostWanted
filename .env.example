# Copia este archivo como .env y configura tus credenciales reales.
# IMPORTANTE: Nunca subas el archivo .env con secretos a git.

# Debug/Test Mode
# Cuando es true: desactiva los limitadores de envio de reportes para pruebas rápidas
DEBUG_MODE=false

# Frontend (Vite)
VITE_DEV_PORT=5180
VITE_API_BASE_URL=https://api.kaithsrebels.com/api
VITE_IA_ENDPOINT=https://api.kaithsrebels.com/api/ia-chat
VITE_IA_INTENT_ENDPOINT=https://api.kaithsrebels.com/api/ia-intent
VITE_IA_REPORT_CORRELATION_ENDPOINT=https://api.kaithsrebels.com/api/ia-report-correlation
VITE_IA_MODEL=qwen2.5:latest
VITE_DISCORD_CLIENT_ID=tu_client_id
VITE_DISCORD_REDIRECT_URI=https://tudominio.com/auth-callback
VITE_DISCORD_ID_CHANNEL=tu_channel_id
# El webhook de Discord debe existir solo en backend: DISCORD_WEBHOOK_URL.
VITE_API_KEY_IMGBB=tu_imgbb_api_key

# Servidor (Node / VPS)
DISCORD_CLIENT_ID=tu_client_id
DISCORD_CLIENT_SECRET=tu_client_secret
DISCORD_REDIRECT_URI=https://tudominio.com/auth-callback
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/tu_webhook
HEXBOT_API_BASE_URL=https://hex-api.kaithsrebels.com
HEXBOT_API_SECRET=tu_hexbot_api_secret
HEXBOT_API_TIMEOUT_MS=8000

DB_HOST=tu_host_mysql
DB_PORT=3306
DB_USER=tu_usuario_mysql
DB_PASSWORD=tu_password_mysql
DB_NAME=tu_base_de_datos

KAITH_AI_USER=tu_usuario_api_ia
KAITH_AI_PASSWORD=tu_password_api_ia
KAITH_AI_ENDPOINT=https://api.kaithsrebels.com/api/generate
KAITH_AI_USE_LOCAL_OLLAMA=true
KAITH_OLLAMA_ENDPOINT=http://127.0.0.1:11434/api/generate
KAITH_OLLAMA_MODEL=qwen2.5:latest

PORT=3000
